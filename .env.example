# Copy to .env and fill in. docker-compose.yml loads this same file into the container, so the two
# deployments read one set of knobs — but two of them are wired to the container and should be left
# alone there: PORT is the container-side port docker-compose.yml publishes as 127.0.0.1:8090, and
# DATA_DIR resolves to the /app/data bind mount.

# HTTP port the server listens on
PORT=8080

# Directory for run artifacts and local state
DATA_DIR=./data

# Shared access code required to use the app. In production (NODE_ENV=production, which the image
# sets) the server refuses to boot unless this is set and at least 12 characters: it is the only
# thing between the internet and an agent that spends money, and nothing rate-limits guesses. The
# value below is published in this repository — it is a laptop default, not a code.
ACCESS_CODE=dev-code

# Anthropic API key (no default — required for agent runs)
ANTHROPIC_API_KEY=

# Model used by the agent loop
NOCTUA_MODEL=claude-sonnet-5

# Reasoning effort: low | medium | high | xhigh | max. Anything else falls back to medium, loudly.
NOCTUA_EFFORT=medium

# The caps below are read as plain numbers, and every one of them is compared with ">" — which is
# false for NaN, so an unreadable value would remove the cap rather than change it. Nothing here
# means "unlimited": 0, a negative, or a line with a trailing comment on it (docker's env_file
# keeps those) falls back to the default printed beside it.

# Max agent steps per run
NOCTUA_MAX_STEPS=40

# Max USD spend for a single run
NOCTUA_MAX_RUN_COST=1.5

# Max wall-clock minutes for a single run
NOCTUA_MAX_WALL_MIN=15

# Minutes a run waits for an approval or an answer before giving up on the human: an abandoned
# approval is then denied and an abandoned question answers itself, so the run frees its slot.
# There is no "wait for ever" — 0, blank or nonsense falls back to 10.
NOCTUA_MAX_WAIT_MIN=10

# Max USD spend across all runs per day
NOCTUA_DAILY_COST_CAP=20

# Max runs executing at the same time
NOCTUA_MAX_CONCURRENT=2
