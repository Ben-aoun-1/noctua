# HTTP port the server listens on
PORT=8080

# Directory for run artifacts and local state
DATA_DIR=./data

# Shared access code required to use the app
ACCESS_CODE=dev-code

# Anthropic API key (no default — required for agent runs)
ANTHROPIC_API_KEY=

# Model used by the agent loop
NOCTUA_MODEL=claude-sonnet-5

# Reasoning effort: low | medium | high
NOCTUA_EFFORT=medium

# Max agent steps per run
NOCTUA_MAX_STEPS=40

# Max USD spend for a single run
NOCTUA_MAX_RUN_COST=1.5

# Max wall-clock minutes for a single run
NOCTUA_MAX_WALL_MIN=15

# Max USD spend across all runs per day
NOCTUA_DAILY_COST_CAP=20

# Max runs executing at the same time
NOCTUA_MAX_CONCURRENT=2
